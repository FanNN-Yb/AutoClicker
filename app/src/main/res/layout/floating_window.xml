<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/floating_window_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- ====== 主页面 ====== -->
    <LinearLayout
        android:id="@+id/panelMain"
        android:layout_width="155dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.02"
                android:text="宏控制"
                android:textColor="@color/floating_window_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/btn_close_bg"
                android:contentDescription="关闭"
                android:padding="4dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- 左右分栏 -->
        <LinearLayout
            android:layout_width="155dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 左侧：配置列表 -->
            <ScrollView
                android:layout_width="17dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="0.7"
                android:fadingEdge="vertical"
                android:fadingEdgeLength="12dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/configListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- 右侧：参数 + 启用 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- 速度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="速度"
                        android:textColor="@color/floating_window_text_secondary"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etSpeed"
                        android:layout_width="42dp"
                        android:layout_height="22dp"
                        android:background="@drawable/edit_text_bg"
                        android:gravity="center"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="4dp"
                        android:singleLine="true"
                        android:text="1.0"
                        android:textColor="@color/floating_window_text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="倍"
                        android:textColor="@color/floating_window_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 次数 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="次数"
                        android:textColor="@color/floating_window_text_secondary"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etRepeatCount"
                        android:layout_width="42dp"
                        android:layout_height="22dp"
                        android:background="@drawable/edit_text_bg"
                        android:gravity="center"
                        android:inputType="number"
                        android:paddingHorizontal="4dp"
                        android:singleLine="true"
                        android:text="1"
                        android:textColor="@color/floating_window_text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="次"
                        android:textColor="@color/floating_window_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 启用按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnable"
                    android:layout_width="65dp"
                    android:layout_height="24dp"
                    android:enabled="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="启用"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    app:cornerRadius="30dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ====== 小窗口（宏按钮模式） ====== -->
    <LinearLayout
        android:id="@+id/panelExecuting"
        android:layout_width="68dp"
        android:layout_height="60dp"
        android:layout_margin="0dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 上排：圆形返回 + 拖动区域（各占 50% 宽） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="1dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnExecBack"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/btn_circle_bg"
                android:contentDescription="返回"
                android:padding="2dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_chevron_left" />

            <View
                android:id="@+id/execDragHandle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="拖动窗口" />
        </LinearLayout>

        <!-- 宏按钮（满宽） -->
        <TextView
            android:id="@+id/btnExecMacro"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="1dp"
            android:layout_weight="1"
            android:background="@drawable/btn_macro_bg"
            android:gravity="center"
            android:textColor="@color/floating_window_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- ====== 录制页面 ====== -->
    <LinearLayout
        android:id="@+id/panelRecord"
        android:layout_width="146dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 标题栏：左"录制宏" + 右"返回" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/recordTitleBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.02"
                android:text="录制宏"
                android:textColor="@color/floating_window_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnRecordBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/btn_close_bg"
                android:contentDescription="返回"
                android:padding="4dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- 提示文字 -->
        <TextView
            android:id="@+id/tvRecordHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:gravity="center"
            android:text="点击屏幕开始录制"
            android:textColor="@color/floating_window_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvRecordCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:gravity="center"
            android:text="已录 0 个位置"
            android:textColor="@color/floating_window_text_secondary"
            android:textSize="11sp" />

        <!-- 按钮行：重录 + 保存 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordReset"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="重录"
                android:textAllCaps="false"
                android:textColor="@color/floating_window_text_secondary"
                android:textSize="11sp"
                app:cornerRadius="30dp"
                app:strokeColor="@color/floating_window_stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordSave"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="保存"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:cornerRadius="30dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
